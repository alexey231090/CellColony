[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

var time_passed: float = 0.0
var lifetime: float = 0.16
var color: Color = Color.WHITE
var positions: PackedVector2Array = PackedVector2Array()
var velocities: PackedVector2Array = PackedVector2Array()

func _ready() -> void:
	z_index = 12
	positions.resize(3)
	velocities.resize(3)
	for i in range(3):
		positions[i] = Vector2.ZERO
		velocities[i] = Vector2(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)).normalized() * randf_range(110.0, 220.0)

func _process(delta: float) -> void:
	time_passed += delta
	if time_passed > lifetime:
		queue_free()
		return
	
	for i in range(3):
		positions[i] += velocities[i] * delta
	queue_redraw()

func _draw() -> void:
	var factor: float = 1.0 - (time_passed / lifetime)
	var c: Color = color
	c.a = factor
	var r: float = 3.5 * factor
	for i in range(3):
		draw_circle(positions[i], r, c)
"

[node name="ImpactEffect" type="Node2D"]
script = SubResource("GDScript_1")
